---
layout: layouts/page.njk
permalink: /calls/
pageTitle: Calls
pageIntro: Submission forms and deadlines will appear here as each call opens.
---
<div class="call-list">
  {% for call in calls %}
  <article class="call" id="{{ call.id }}">
    <div class="call__head">
      <h2>{{ call.title }}</h2>
      {% if call.status == "open" %}<span class="status status--open">Open</span>
      {% elif call.status == "closed" %}<span class="status">Closed</span>
      {% else %}<span class="status">Not yet open</span>{% endif %}
    </div>
    <p>{{ call.description }}</p>
    <p class="call__deadline"><strong>Deadline:</strong> {{ dates | milestoneDate(call.deadline) | displayDate }}</p>
    {% if call.status == "open" %}<p><a class="button" href="{{ call.form_url }}">Submit</a></p>{% endif %}
  </article>
  {% endfor %}
</div>

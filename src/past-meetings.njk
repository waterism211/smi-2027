---
layout: layouts/page.njk
permalink: /past-meetings/
pageTitle: Past Meetings
pageIntro: Earlier meetings in the Statistical Methods in Imaging series.
---
<table class="dates">
  <thead><tr><th scope="col">Year</th><th scope="col">Host</th><th scope="col">Location</th></tr></thead>
  <tbody>
    {% for meeting in pastMeetings %}
    <tr>
      <td>{% if meeting.url %}<a href="{{ meeting.url }}">{{ meeting.year }}</a>{% else %}{{ meeting.year }}{% endif %}</td>
      <td>{{ meeting.host }}</td>
      <td>{{ meeting.location }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<p class="note">Source: <a href="https://www.statsinimaging.org/events_smi/">ASA Statistics in Imaging Section</a>.</p>

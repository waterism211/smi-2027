---
layout: layouts/page.njk
permalink: /committee/
pageTitle: Committee
---
{% for group in committee %}
<section class="content-section">
  <h2>{{ group.name }}</h2>
  {% if group.members.length %}
  <ul class="people">
    {% for person in group.members %}
    <li>
      <span class="people__name">{% if person.url %}<a href="{{ person.url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}</span>
      {% if person.role %}<span class="people__role">{{ person.role }}</span>{% endif %}
      <span>{{ person.affiliation }}</span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>Members will be announced here.</p>
  {% endif %}
</section>
{% endfor %}
